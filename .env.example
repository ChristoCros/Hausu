# Database configuration (for SQLite, this is a local path)
DATABASE_URL="file:./dev.db"

# Shelly device IP address on your local network
NEXT_PUBLIC_SHELLY_IP="192.168.1.XX"

# InfluxDB configuration for energy history
INFLUXDB_URL="http://127.0.0.1:8086"
INFLUXDB_TOKEN="your-influxdb-token"
INFLUXDB_ORG="your-org"
INFLUXDB_BUCKET="Hausu_bucket"

# Generic coordinates (default is Paris) to hide your city location
NEXT_PUBLIC_LATITUDE=48.8566
NEXT_PUBLIC_LONGITUDE=2.3522
NEXT_PUBLIC_CITY_NAME="Paris"
# MAC address of your Netatmo weather station
NETATMO_STATION_ID="70:ee:50:b0:91:7c"

# Optional Netatmo OAuth credentials
NETATMO_CLIENT_ID="your-client-id"
NETATMO_CLIENT_SECRET="your-client-secret"
NETATMO_REFRESH_TOKEN="your-refresh-token"
